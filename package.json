{
    "name": "torero-mq",
    "version": "0.2.0",
    "description": "Type-safe BullMQ queues you can tame.",
    "type": "module",
    "private": false,
    "packageManager": "pnpm@12.14.0",
    "engines": {
        "node": ">=26"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./contract": {
            "types": "./dist/contract.d.ts",
            "import": "./dist/contract.js",
            "default": "./dist/contract.js"
        }
    },
    "files": [
        "dist",
        "src/**/*.ts",
        "!src/**/*.test.ts",
        "!src/**/*.test-d.ts"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.build.json",
        "dev": "tsc -w -p tsconfig.build.json",
        "test": "vitest run",
        "test:coverage": "node scripts/test-redis.mjs --all --coverage",
        "lint": "oxlint",
        "format": "prettier -w .",
        "format:check": "prettier -c .",
        "prepublishOnly": "npm run build",
        "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.types.json",
        "test:watch": "vitest",
        "test:integration": "node scripts/test-redis.mjs",
        "test:package": "pnpm build && node scripts/package-smoke.mjs",
        "release:version": "changeset version",
        "release:publish": "pnpm build && changeset publish"
    },
    "keywords": [
        "bullmq",
        "queue",
        "redis",
        "jobs",
        "typescript",
        "zod"
    ],
    "peerDependencies": {
        "bullmq": "^6.3.17",
        "ioredis": "^6.0.0"
    },
    "devDependencies": {
        "@changesets/cli": "3.0.3",
        "@types/node": "26.6.5",
        "@vitest/coverage-v8": "5.0.5",
        "bullmq": "6.3.17",
        "ioredis": "6.0.0",
        "oxlint": "1.88.0",
        "prettier": "3.9.10",
        "typescript": "7.0.2",
        "vitest": "5.0.5",
        "zod": "4.6.7"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/josehdez01/torero-mq.git"
    },
    "bugs": {
        "url": "https://github.com/josehdez01/torero-mq/issues"
    },
    "homepage": "https://github.com/josehdez01/torero-mq#readme",
    "sideEffects": false,
    "dependencies": {
        "@standard-schema/spec": "1.1.0",
        "superjson": "2.2.6"
    },
    "peerDependenciesMeta": {
        "ioredis": {
            "optional": true
        }
    }
}
